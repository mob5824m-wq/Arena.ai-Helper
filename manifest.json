{
  "manifest_version": 3,
  "name": "Arena.ai Helper - Tool-Call Limit Auto-Continue",
  "version": "3.0.1",
  "description": "Adds automatic continuation when Arena's agent reaches the tool-call limit, plus all auto-scroll, auto-send, queue, captcha safety, export, and shortcut features.",
  "permissions": ["storage", "notifications", "scripting", "clipboardRead"],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://arena.ai/*",
    "https://*.arena.ai/*",
    "https://*.e2b.app/*",
    "https://*.e2b.dev/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Arena.ai Helper - Tool-Call Limit Auto-Continue",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-auto-send": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Toggle auto-send"
    },
    "toggle-auto-scroll": {
      "suggested_key": { "default": "Alt+Shift+A" },
      "description": "Toggle auto-scroll"
    },
    "clear-input": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Clear input and queue"
    },
    "stop-after-this": {
      "suggested_key": { "default": "Alt+Shift+X" },
      "description": "Stop queue after this response"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://arena.ai/*",
        "https://*.arena.ai/*",
        "https://*.e2b.app/*",
        "https://*.e2b.dev/*"
      ],
      "js": [
        "lib/state.js",
        "lib/ui.js",
        "lib/theme.js",
        "features/captcha.js",
        "features/scroll.js",
        "features/send.js",
        "features/queue.js",
        "features/continue.js",
        "features/toollimit.js",
        "features/notifications.js",
        "features/autofocus.js",
        "features/export.js",
        "features/copycode.js",
        "features/timestamps.js",
        "features/closeprotect.js",
        "features/quickprompts.js",
        "features/floatingstatus.js",
        "features/counter.js",
        "features/history.js",
        "features/debugoverlay.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": false
    }
  ]
}
